[Unit]
Description=Project SENTINEL — eBPF Agent (requires kernel access)
After=network-online.target sentinel-hub.service
Wants=network-online.target sentinel-hub.service

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/sentinel
EnvironmentFile=-/etc/sentinel/sentinel.env
# Tracepoints attach through tracefs; some minimal/VM installs never mount it.
ExecStartPre=/bin/sh -c 'test -d /sys/kernel/tracing/events || test -d /sys/kernel/debug/tracing/events || mkdir -p /sys/kernel/tracing 2>/dev/null; test -d /sys/kernel/tracing/events || mount -t tracefs tracefs /sys/kernel/tracing 2>/dev/null || mount -t debugfs debugfs /sys/kernel/debug 2>/dev/null || true'
ExecStart=/opt/sentinel/.venv/bin/python agent/sentinel_lineage_agent.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

# ─── eBPF needs kernel access: runs as root, minimal hardening ───
NoNewPrivileges=no
PrivateTmp=yes
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths=/var/lib/sentinel /sys
AmbientCapabilities=CAP_BPF CAP_PERFMON CAP_SYS_ADMIN

[Install]
WantedBy=multi-user.target

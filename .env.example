# Project SENTINEL — Environment Configuration
# Installed to /etc/sentinel/sentinel.env by install.sh. Edit there.
#
# ⚠ The four "Required secrets" below MUST be set or the hub refuses to start.
#   install.sh generates them for you. Use `install.sh --reset-credentials`
#   to rotate the dashboard password.

# ─── Required secrets (hub fails closed without these) ───
# Agent enrollment key — sent as the X-Sentinel-Key header on every agent request.
SENTINEL_AGENT_KEY=CHANGE_ME_AGENT_KEY
# HMAC key for dashboard session cookies + CSRF tokens.
SENTINEL_SESSION_SECRET=CHANGE_ME_SESSION_SECRET
# HMAC key for the signed allowlist blob distributed to agents.
SENTINEL_ALLOWLIST_KEY=CHANGE_ME_ALLOWLIST_KEY
# Dashboard password for SENTINEL_ADMIN_USER (default: admin).
SENTINEL_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
SENTINEL_ADMIN_USER=admin

# ─── Paths (set by installer; override if relocating) ───
SENTINEL_CONFIG=/etc/sentinel/rules.yaml
SENTINEL_GEO_RULES=/etc/sentinel/geo_rules.json
SENTINEL_DB=/var/lib/sentinel/lineage_db.json
SENTINEL_AGENT_DB=/var/lib/sentinel/agent_state.json
SENTINEL_DB_PATH=/var/lib/sentinel/sentinel.db
SENTINEL_TRUSTED=/etc/sentinel/trusted_binaries.json
SENTINEL_EBPF=/opt/sentinel/ebpf/sentinel_lineage.bpf.c

# ─── Hub ───
SENTINEL_PORT=5000

# ─── Hub scale (multi-worker) ───
# Unset  → in-memory state. Serve with EXACTLY ONE gunicorn worker (-w 1).
# Set    → shared state in Redis. Scale workers freely (-w 4 or more).
#          Requires: pip install redis
# SENTINEL_REDIS_URL=redis://127.0.0.1:6379/0

# ─── Agent → Hub ───
SENTINEL_COLLECTOR_URL=http://127.0.0.1:5000/api/v1/telemetry

# ─── Telegram Alerts (optional) ───
# Leave both unset to disable notifications. A placeholder token is ignored
# (a single startup warning is logged) — it never triggers an API call.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# ─── GeoIP ───
# GeoLite2 database path (auto-detected if not set)
# GEOIP_DB_PATH=/usr/share/GeoIP/GeoLite2-Country.mmdb

# ─── TLS / Secure Cookies ───
# Set SENTINEL_SESSION_COOKIE_SECURE=1 behind a TLS-terminating proxy (nginx/Caddy).
# The hub will set the Secure flag on session cookies. Default is 0 for local dev.
# SENTINEL_SESSION_COOKIE_SECURE=1
